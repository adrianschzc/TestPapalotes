@model Usuario
@{ ViewData["Title"] = "Editar usuario"; }

<h2>Editar usuario</h2>
<form asp-action="Edit" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="NombreUsuario" class="form-label"></label><input asp-for="NombreUsuario" class="form-control" /><span asp-validation-for="NombreUsuario" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="NombreCompleto" class="form-label"></label><input asp-for="NombreCompleto" class="form-control" /><span asp-validation-for="NombreCompleto" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Rol" class="form-label"></label><select asp-for="Rol" asp-items="ViewBag.Roles" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="GrupoId" class="form-label"></label><select asp-for="GrupoId" asp-items="ViewBag.Grupos" class="form-select"><option value="">-- Sin grupo --</option></select></div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
