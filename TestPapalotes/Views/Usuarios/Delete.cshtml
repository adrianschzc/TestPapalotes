@model Usuario
@{ ViewData["Title"] = "Eliminar usuario"; }

<h2>¿Eliminar este usuario?</h2>
<dl class="row col-md-6">
    <dt class="col-sm-4">Usuario</dt><dd class="col-sm-8">@Model.NombreUsuario</dd>
    <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.NombreCompleto</dd>
    <dt class="col-sm-4">Rol</dt><dd class="col-sm-8">@Model.Rol</dd>
    <dt class="col-sm-4">Grupo</dt><dd class="col-sm-8">@(Model.Grupo?.Clave ?? "-")</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
