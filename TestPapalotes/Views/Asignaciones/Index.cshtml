@model IEnumerable<Asignacion>
@{ ViewData["Title"] = "Asignaciones"; }

<h2>Asignaciones de materias</h2>
<p class="text-muted">Cada asignación vincula una <strong>materia</strong> con un <strong>grupo</strong> y el <strong>profesor</strong> que la imparte. Usa el botón <strong>Alumnos</strong> para asignar o quitar alumnos de la materia.</p>
<p><a class="btn btn-success" asp-action="Create">+ Nueva asignación</a></p>

<table class="table table-striped">
    <thead><tr><th>Materia</th><th>Grupo</th><th>Profesor</th><th></th></tr></thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Materia?.Nombre</td>
                <td>@a.Grupo?.Clave</td>
                <td>@a.Profesor?.Nombre</td>
                <td>
                    <a class="btn btn-sm btn-outline-info" asp-action="Detalle" asp-route-id="@a.Id">Alumnos</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@a.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
