@model Asignacion
@{ ViewData["Title"] = "Nueva asignación"; }

<h2>Nueva asignación</h2>
<form asp-action="Create" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="MateriaId" class="form-label"></label><select asp-for="MateriaId" asp-items="ViewBag.Materias" class="form-select"><option value="">-- Seleccione --</option></select></div>
    <div class="mb-3"><label asp-for="GrupoId" class="form-label"></label><select asp-for="GrupoId" asp-items="ViewBag.Grupos" class="form-select"><option value="">-- Seleccione --</option></select></div>
    <div class="mb-3"><label asp-for="ProfesorId" class="form-label"></label><select asp-for="ProfesorId" asp-items="ViewBag.Profesores" class="form-select"><option value="">-- Seleccione --</option></select></div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
