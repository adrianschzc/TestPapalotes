<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control Escolar</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestPapalotes.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Control Escolar</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" data-bs-toggle="dropdown">Administración</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Roles de usuarios</a></li>
                                <li><a class="dropdown-item" asp-controller="Materias" asp-action="Index">Materias</a></li>
                                <li><a class="dropdown-item" asp-controller="Grupos" asp-action="Index">Grupos</a></li>
                                <li><a class="dropdown-item" asp-controller="Profesores" asp-action="Index">Profesores</a></li>
                                <li><a class="dropdown-item" asp-controller="Alumnos" asp-action="Index">Alumnos</a></li>
                                <li><a class="dropdown-item" asp-controller="Asignaciones" asp-action="Index">Asignaciones</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Docente" asp-action="Index">Panel Docente</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="AlumnoPanel" asp-action="Index">Panel Alumno</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
