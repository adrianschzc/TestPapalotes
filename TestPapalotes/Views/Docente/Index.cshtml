@model BoletaCalificacionesVM
@{ ViewData["Title"] = "Panel del docente"; }

<h2>Registro de calificaciones</h2>
<p class="text-muted">Ingrese el número de boleta del alumno para capturar sus calificaciones.</p>

<form asp-action="Buscar" method="post" class="row g-2 col-md-6 mb-3">
    <div class="col-8">
        <input name="boleta" value="@Model.Boleta" class="form-control" placeholder="Número de boleta (ej. 2023630001)" />
    </div>
    <div class="col-4">
        <button type="submit" class="btn btn-primary w-100">Buscar</button>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-warning">@ViewBag.Error</div>
}
@if (ViewBag.Ok != null)
{
    <div class="alert alert-success">@ViewBag.Ok</div>
}

@if (Model.AlumnoId > 0)
{
    <div class="card">
        <div class="card-header">
            <strong>@Model.AlumnoNombre</strong> — Boleta @Model.Boleta — Grupo @Model.Grupo
        </div>
        <div class="card-body">
            @if (Model.Filas.Count == 0)
            {
                <p class="text-muted">Este alumno no tiene materias asignadas en su grupo.</p>
            }
            else
            {
                <form asp-action="Guardar" method="post">
                    <input type="hidden" asp-for="Boleta" />
                    <input type="hidden" asp-for="AlumnoId" />
                    <table class="table">
                        <thead><tr><th>Materia</th><th>Profesor</th><th style="width:160px">Calificación</th></tr></thead>
                        <tbody>
                            @for (int i = 0; i < Model.Filas.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Model.Filas[i].Materia
                                        <input type="hidden" asp-for="Filas[i].AsignacionId" />
                                        <input type="hidden" asp-for="Filas[i].Materia" />
                                    </td>
                                    <td>@Model.Filas[i].Profesor</td>
                                    <td><input asp-for="Filas[i].Valor" type="number" step="0.1" min="0" max="100" class="form-control" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="submit" class="btn btn-success">💾 Guardar calificaciones</button>
                </form>
            }
        </div>
    </div>
}
