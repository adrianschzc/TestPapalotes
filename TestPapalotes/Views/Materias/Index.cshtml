@model IEnumerable<Materia>
@{ ViewData["Title"] = "Materias"; }

<h2>Materias</h2>
<p><a class="btn btn-success" asp-action="Create">+ Nueva materia</a></p>

<table class="table table-striped">
    <thead><tr><th>Clave</th><th>Nombre</th><th>Créditos</th><th></th></tr></thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Clave</td>
                <td>@m.Nombre</td>
                <td>@m.Creditos</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@m.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
