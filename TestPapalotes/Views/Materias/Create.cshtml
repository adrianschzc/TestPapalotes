@model Materia
@{ ViewData["Title"] = "Nueva materia"; }

<h2>Nueva materia</h2>
<form asp-action="Create" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Clave" class="form-label"></label><input asp-for="Clave" class="form-control" /><span asp-validation-for="Clave" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Creditos" class="form-label"></label><input asp-for="Creditos" class="form-control" /><span asp-validation-for="Creditos" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
