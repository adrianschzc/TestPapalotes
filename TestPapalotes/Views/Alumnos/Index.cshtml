@model IEnumerable<Alumno>
@{ ViewData["Title"] = "Alumnos"; }

<h2>Alumnos</h2>
<p><a class="btn btn-success" asp-action="Create">+ Nuevo alumno</a></p>

<table class="table table-striped">
    <thead><tr><th>Boleta</th><th>Nombre</th><th>Correo</th><th>Grupo</th><th></th></tr></thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Boleta</td>
                <td>@a.Nombre</td>
                <td>@a.Correo</td>
                <td>@(a.Grupo?.Clave ?? "-")</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@a.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
