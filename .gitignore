# ---------------------------------------------
# .gitignore para proyecto .NET / ASP.NET Core
# ---------------------------------------------

# Carpetas de compilacion
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Resultados de compilacion / publicacion
publish/
[Pp]ublish[Pp]rofiles/*.pubxml.user
*.dll
*.exe
*.pdb

# Archivos de configuracion con secretos
appsettings.Development.json
appsettings.Production.json
appsettings.*.Local.json
secrets.json
*.env
.env

# Certificados y llaves
*.pfx
*.p12
*.key
*.pem

# Bases de datos locales
*.mdf
*.ldf
*.db

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.assets.json

# Logs y temporales
*.log
*.tmp
[Tt]emp/

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store
